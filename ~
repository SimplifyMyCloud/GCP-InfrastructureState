+// ---------------------------------------------------------------------------
+// The Fort Knox Model — defense-in-depth on GCP
+//
+// Concentric rings of GCP controls around your data, mapped to the Fort Knox
+// analogy. An attacker is repelled at the outer wall; watchtowers watch every
+// ring (alarms on the way IN and OUT with the loot).
+//
+//   svg:  dot -Tsvg fort-knox-defense.dot -o fort-knox-defense.svg
+//   png:  dot -Tpng -Gdpi=200 fort-knox-defense.dot -o fort-knox-defense.png
+// ---------------------------------------------------------------------------
+
+digraph fort_knox {
+    compound = true;
+    rankdir  = TB;
+    bgcolor  = "white";
+    pad      = "0.5";
+    nodesep  = 0.45;
+    ranksep  = 0.55;
+    fontname = "Helvetica";
+
+    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, margin="0.3,0.16"];
+    edge [fontname="Helvetica", fontsize=11, color="#5f6368", penwidth=1.4];
+
+    // ----- Concentric defense rings (outer → inner) -----
+    subgraph cluster_perimeter {
+        labelloc = "t"; fontsize = 12; style = "rounded,filled";
+        fillcolor = "#eef1ec"; color = "#5b6650"; penwidth = 2;
+        label = <<B>RING 1 · PERIMETER</B> — fences · guards · guns<BR/><FONT POINT-SIZE="10">Cloud Armor — WAF + rate-limit ban + Adaptive Protection</FONT>>;
+
+        subgraph cluster_iap {
+            labelloc = "t"; fontsize = 12; style = "rounded,filled";
+            fillcolor = "#fef7e0"; color = "#f9ab00"; penwidth = 4;
+            label = <<B>RING 2 · THE GATE</B> — no entry without ID (the 302)<BR/><FONT POINT-SIZE="10">Identity-Aware Proxy — Google-grade auth (billions of accounts)</FONT>>;
+
+            subgraph cluster_building {
+                labelloc = "t"; fontsize = 12; style = "rounded,filled";
+                fillcolor = "#e8f0fe"; color = "#1967d2"; penwidth = 2;
+                label = <<B>RING 3 · SEALED BUILDING</B> — one road in<BR/><FONT POINT-SIZE="10">Locked Cloud Run ingress — load-balancer only</FONT>>;
+
+                subgraph cluster_vault {
+                    labelloc = "t"; fontsize = 12; style = "rounded,filled";
+                    fillcolor = "#fde7e9"; color = "#d93025"; penwidth = 2;
+                    label = <<B>RING 4 · VAULT DOOR</B> — barely touch anything inside<BR/><FONT POINT-SIZE="10">Least-privilege service account</FONT>>;
+
+                    subgraph cluster_cage {
+                        labelloc = "t"; fontsize = 12; style = "rounded,filled";
+                        fillcolor = "#fff7d6"; color = "#b8860b"; penwidth = 2;
+                        label = <<B>RING 5 · THE CAGE</B><BR/><FONT POINT-SIZE="10">Private-IP Cloud SQL + Secret Manager</FONT>>;
+
+                        gold [fillcolor="#f4b53a", color="#8a6d1a", penwidth=2, fontsize=14,
+                              label=<<B>THE GOLD</B><BR/><FONT POINT-SIZE="10">your data — DB rows · secrets · pages</FONT>>];
+                    }
+                }
+            }
+        }
+    }
+
+    // ----- Attacker + watchtowers (outside the rings) -----
+    attacker [fillcolor="#fce8e6", color="#d93025", penwidth=2,
+              label=<<B>GAMILAS</B><BR/><FONT POINT-SIZE="10">brute force · scan · insider</FONT>>];
+    noc [fillcolor="#e6f4ea", color="#188038", penwidth=2,
+         label=<<B>WATCHTOWERS &amp; ALARMS</B><BR/><FONT POINT-SIZE="10">Logging · Alerts · NOC · 365-day archive<BR/>alarms on the way IN and OUT with the loot</FONT>>];
+
+    // Edges clip at the ring they reach (compound=true).
+    attacker -> gold [lhead=cluster_perimeter, color="#d93025", penwidth=2.2, label="repelled at\nthe wall (403)"];
+    noc -> gold [lhead=cluster_perimeter, color="#188038", style=dotted, dir=both, label="watches\nevery ring"];
+
+    { rank = same; attacker; noc; }
+}
