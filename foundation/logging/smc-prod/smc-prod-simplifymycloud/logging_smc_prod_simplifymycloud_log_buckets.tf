# ---------------------------------------------------------------------------------------------------------------------
# Foundation Layer
# logging — smc-prod / smc-prod-simplifymycloud — log buckets
# ---------------------------------------------------------------------------------------------------------------------
#
# Imported from the live Org on 2026-11-01. Every value is what GCP reported;
# the code was generated by `terraform plan -generate-config-out` and tidied.

resource "google_logging_project_bucket_config" "default" {
  bucket_id        = "_Default"
  description      = "Default bucket"
  enable_analytics = false
  location         = "global"
  locked           = false
  project          = "projects/smc-prod-simplifymycloud"
  retention_days   = 30
}

import {
  to = google_logging_project_bucket_config.default
  id = "projects/smc-prod-simplifymycloud/locations/global/buckets/_Default"
}
