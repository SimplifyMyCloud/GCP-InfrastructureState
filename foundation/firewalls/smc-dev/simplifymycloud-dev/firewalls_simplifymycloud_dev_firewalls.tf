# ---------------------------------------------------------------------------------------------------------------------
# Foundation Layer
# firewalls — smc-dev / simplifymycloud-dev — firewall rules and Cloud Armor
# ---------------------------------------------------------------------------------------------------------------------
#
# Imported from the live Org on 2026-11-01. Every value is what GCP reported;
# the code was generated by `terraform plan -generate-config-out` and tidied.
#
# 2026-11-02: smc-fw-public-22 (SSH from 0.0.0.0/0) was DELETED. SSH goes through
# IAP only (smc-fw-iap-22): gcloud compute ssh <vm> --tunnel-through-iap

resource "google_compute_firewall" "default_allow_https" {
  direction     = "INGRESS"
  disabled      = false
  name          = "default-allow-https"
  network       = "https://www.googleapis.com/compute/v1/projects/simplifymycloud-dev/global/networks/default"
  priority      = 1000
  project       = "simplifymycloud-dev"
  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["https-server"]
  allow {
    ports    = ["443"]
    protocol = "tcp"
  }
}

import {
  to = google_compute_firewall.default_allow_https
  id = "projects/simplifymycloud-dev/global/firewalls/default-allow-https"
}

