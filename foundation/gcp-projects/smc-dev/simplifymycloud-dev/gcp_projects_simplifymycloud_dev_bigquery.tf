resource "google_bigquery_table" "phishing_poc_v_campaign_summary" {
  dataset_id               = "phishing_poc"
  deletion_protection      = true
  expiration_time          = 0
  labels                   = {}
  project                  = "simplifymycloud-dev"
  require_partition_filter = false
  resource_tags            = {}
  schema = jsonencode([{
    name = "campaign_id"
    type = "STRING"
    }, {
    name = "campaign_idx"
    type = "INTEGER"
    }, {
    name = "campaign_name"
    type = "STRING"
    }, {
    name = "template"
    type = "STRING"
    }, {
    name = "lure_type"
    type = "STRING"
    }, {
    name = "launch_date"
    type = "DATE"
    }, {
    name = "emails_sent"
    type = "INTEGER"
    }, {
    name = "emails_delivered"
    type = "INTEGER"
    }, {
    name = "emails_opened"
    type = "INTEGER"
    }, {
    name = "emails_clicked"
    type = "INTEGER"
    }, {
    name = "credentials_submitted"
    type = "INTEGER"
    }, {
    name = "computers_infected"
    type = "INTEGER"
    }, {
    name = "emails_reported"
    type = "INTEGER"
    }, {
    name = "click_rate"
    type = "FLOAT"
    }, {
    name = "infection_rate"
    type = "FLOAT"
    }, {
    name = "report_rate"
    type = "FLOAT"
  }])
  table_id = "v_campaign_summary"
  view {
    query          = "SELECT\n  campaign_id,\n  campaign_idx,\n  campaign_name,\n  template,\n  lure_type,\n  launch_date,\n  COUNT(*)                          AS emails_sent,\n  COUNTIF(is_delivered)             AS emails_delivered,\n  COUNTIF(is_opened)                AS emails_opened,\n  COUNTIF(is_clicked)               AS emails_clicked,\n  COUNTIF(is_credentials_submitted) AS credentials_submitted,\n  COUNTIF(is_infected)              AS computers_infected,\n  COUNTIF(is_reported)              AS emails_reported,\n  SAFE_DIVIDE(COUNTIF(is_clicked),  COUNT(*)) AS click_rate,\n  SAFE_DIVIDE(COUNTIF(is_infected), COUNT(*)) AS infection_rate,\n  SAFE_DIVIDE(COUNTIF(is_reported), COUNT(*)) AS report_rate\nFROM `simplifymycloud-dev.phishing_poc.v_recipients_enriched`\nGROUP BY campaign_id, campaign_idx, campaign_name, template, lure_type, launch_date"
    use_legacy_sql = false
  }
}

