resource "google_bigquery_table" "phishing_poc_v_recipients_enriched" {
  dataset_id               = "phishing_poc"
  deletion_protection      = true
  expiration_time          = 0
  labels                   = {}
  project                  = "simplifymycloud-dev"
  require_partition_filter = false
  resource_tags            = {}
  schema = jsonencode([{
    name = "campaign_id"
    type = "STRING"
    }, {
    name = "campaign_idx"
    type = "INTEGER"
    }, {
    name = "campaign_name"
    type = "STRING"
    }, {
    name = "template"
    type = "STRING"
    }, {
    name = "lure_type"
    type = "STRING"
    }, {
    name = "difficulty"
    type = "STRING"
    }, {
    name = "launch_date"
    type = "DATE"
    }, {
    name = "employee_id"
    type = "STRING"
    }, {
    name = "employee_name"
    type = "STRING"
    }, {
    name = "email"
    type = "STRING"
    }, {
    name = "department"
    type = "STRING"
    }, {
    name = "title"
    type = "STRING"
    }, {
    name = "location"
    type = "STRING"
    }, {
    name = "device_id"
    type = "STRING"
    }, {
    name = "os"
    type = "STRING"
    }, {
    name = "model"
    type = "STRING"
    }, {
    name = "edr_version"
    type = "STRING"
    }, {
    name = "sent_ts"
    type = "TIMESTAMP"
    }, {
    name = "delivered_ts"
    type = "TIMESTAMP"
    }, {
    name = "opened_ts"
    type = "TIMESTAMP"
    }, {
    name = "clicked_ts"
    type = "TIMESTAMP"
    }, {
    name = "credentials_submitted_ts"
    type = "TIMESTAMP"
    }, {
    name = "payload_executed_ts"
    type = "TIMESTAMP"
    }, {
    name = "reported_ts"
    type = "TIMESTAMP"
    }, {
    name = "is_delivered"
    type = "BOOLEAN"
    }, {
    name = "is_opened"
    type = "BOOLEAN"
    }, {
    name = "is_clicked"
    type = "BOOLEAN"
    }, {
    name = "is_credentials_submitted"
    type = "BOOLEAN"
    }, {
    name = "is_infected"
    type = "BOOLEAN"
    }, {
    name = "is_reported"
    type = "BOOLEAN"
    }, {
    name = "minutes_to_click"
    type = "INTEGER"
    }, {
    name = "minutes_to_report"
    type = "INTEGER"
    }, {
    name = "click_hour_et"
    type = "INTEGER"
    }, {
    name = "click_weekday_et"
    type = "STRING"
  }])
  table_id = "v_recipients_enriched"
  view {
    query          = "SELECT\n  r.campaign_id,\n  c.campaign_idx,\n  c.campaign_name,\n  c.template,\n  c.lure_type,\n  c.difficulty,\n  c.launch_date,\n  r.employee_id,\n  CONCAT(e.first_name, ' ', e.last_name) AS employee_name,\n  e.email,\n  e.department,\n  e.title,\n  e.location,\n  r.device_id,\n  d.os,\n  d.model,\n  d.edr_version,\n  r.sent_ts,\n  r.delivered_ts,\n  r.opened_ts,\n  r.clicked_ts,\n  r.credentials_submitted_ts,\n  r.payload_executed_ts,\n  r.reported_ts,\n  r.delivered_ts             IS NOT NULL AS is_delivered,\n  r.opened_ts                IS NOT NULL AS is_opened,\n  r.clicked_ts               IS NOT NULL AS is_clicked,\n  r.credentials_submitted_ts IS NOT NULL AS is_credentials_submitted,\n  r.payload_executed_ts      IS NOT NULL AS is_infected,\n  r.reported_ts              IS NOT NULL AS is_reported,\n  TIMESTAMP_DIFF(r.clicked_ts,  r.sent_ts, MINUTE) AS minutes_to_click,\n  TIMESTAMP_DIFF(r.reported_ts, r.sent_ts, MINUTE) AS minutes_to_report,\n  EXTRACT(HOUR      FROM r.clicked_ts AT TIME ZONE 'America/New_York') AS click_hour_et,\n  FORMAT_TIMESTAMP('%a', r.clicked_ts, 'America/New_York')            AS click_weekday_et\nFROM `simplifymycloud-dev.phishing_poc.campaign_recipients` r\nJOIN `simplifymycloud-dev.phishing_poc.campaigns` c USING (campaign_id)\nJOIN `simplifymycloud-dev.phishing_poc.employees` e USING (employee_id)\nJOIN `simplifymycloud-dev.phishing_poc.devices`   d USING (device_id)"
    use_legacy_sql = false
  }
}

import {
  to = google_bigquery_table.phishing_poc_v_recipients_enriched
  id = "projects/simplifymycloud-dev/datasets/phishing_poc/tables/v_recipients_enriched"
}

