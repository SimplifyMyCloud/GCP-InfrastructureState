    query          = "SELECT\n  employee_id,\n  employee_name,\n  department,\n  title,\n  location,\n  COUNT(*)              AS campaigns_received,\n  COUNTIF(is_clicked)   AS times_clicked,\n  COUNTIF(is_infected)  AS times_infected,\n  COUNTIF(is_reported)  AS times_reported,\n  MAX(clicked_ts)       AS last_click_ts\nFROM `simplifymycloud-dev.phishing_poc.v_recipients_enriched`\nGROUP BY employee_id, employee_name, department, title, location\nHAVING COUNTIF(is_clicked) >= 2"
    use_legacy_sql = false
  }
}

