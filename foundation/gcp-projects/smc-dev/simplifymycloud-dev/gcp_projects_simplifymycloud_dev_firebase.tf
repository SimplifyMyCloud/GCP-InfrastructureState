resource "google_firebaserules_ruleset" "r_17f67b84_b9d1_4492_a493_59f99b24ae71" {
  project = "simplifymycloud-dev"
  source {
    files {
      content = "service firebase.storage {\n  match /b/{bucket}/o {\n    match /{allPaths=**} {\n      allow read, write: if request.auth!=null;\n    }\n  }\n}\n"
      name    = "storage.rules"
    }
  }
}

