# ---------------------------------------------------------------------------------------------------------------------
# Foundation Layer
# gcp-projects — smc-dev / simplifymycloud-dev — Cloud Build
# ---------------------------------------------------------------------------------------------------------------------
#
# Imported from the live Org on 2026-11-01. Every value is what GCP reported;
# the code was generated by `terraform plan -generate-config-out` and tidied.
#
# NOT imported: trigger "Push-to-any-branch" (5f5a55d6-…, GitHub
# SimplifyMyCloud/solutions-terraform-cloudbuild-gitops, any branch). It uses
# build-config *autodetect*, which the google provider cannot express, and a
# made-up filename would change the trigger.


resource "google_cloudbuild_trigger" "trigger" {
  disabled       = false
  filename       = "cloudbuild.yaml"
  ignored_files  = []
  included_files = []
  location       = "global"
  name           = "trigger"
  project        = "simplifymycloud-dev"
  substitutions  = {}
  tags           = []
  approval_config {
    approval_required = false
  }
  trigger_template {
    branch_name  = "master"
    invert_regex = false
    project_id   = "simplifymycloud-dev"
    repo_name    = "my-infrastructure"
  }
}

import {
  to = google_cloudbuild_trigger.trigger
  id = "projects/simplifymycloud-dev/locations/global/triggers/521ddf62-9fc2-41ca-b521-bb5dbabed334"
}
