# ---------------------------------------------------------------------------------------------------------------------
# Foundation Layer
# gcp-projects — smc-dev / simplifymycloud-dev — App Engine application
# ---------------------------------------------------------------------------------------------------------------------
#
# Imported from the live Org on 2026-11-01. Every value is what GCP reported;
# the code was generated by `terraform plan -generate-config-out` and tidied.

resource "google_app_engine_application" "this" {
  auth_domain    = "gmail.com"
  database_type  = "CLOUD_DATASTORE_COMPATIBILITY"
  location_id    = "us-central"
  project        = "simplifymycloud-dev"
  serving_status = "USER_DISABLED"
  feature_settings {
    split_health_checks = true
  }

  # IAP is OFF (enabled = false, OAuth client 288261943767-k3t599nioq...). Its
  # client secret can't be read back and must never be in git, so Terraform
  # leaves the IAP block alone entirely.
  lifecycle {
    ignore_changes = [iap]
  }
}

import {
  to = google_app_engine_application.this
  id = "simplifymycloud-dev"
}
