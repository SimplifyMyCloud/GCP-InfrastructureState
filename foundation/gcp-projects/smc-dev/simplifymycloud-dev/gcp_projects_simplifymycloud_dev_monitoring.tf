resource "google_monitoring_alert_policy" "smc_dev_api_count_alert" {
  combiner              = "OR"
  display_name          = "smc-dev-api-count-alert"
  enabled               = true
  notification_channels = ["projects/simplifymycloud-dev/notificationChannels/4915390728304699032", "projects/simplifymycloud-dev/notificationChannels/7853331941048277815"]
  project               = "simplifymycloud-dev"
  user_labels           = {}
  alert_strategy {
    notification_prompts = ["OPENED"]
  }
  conditions {
    display_name = "Consumed API - Request count"
    condition_threshold {
      comparison      = "COMPARISON_GT"
      duration        = "0s"
      filter          = "resource.type = \"consumed_api\" AND metric.type = \"serviceruntime.googleapis.com/api/request_count\""
      threshold_value = 250
      aggregations {
        alignment_period     = "86400s"
        cross_series_reducer = "REDUCE_SUM"
        group_by_fields      = []
        per_series_aligner   = "ALIGN_SUM"
      }
      trigger {
        count   = 1
        percent = 0
      }
    }
  }
  documentation {
    subject = "SMC-DEV API Count Alert"
  }

  # Live alert has no documentation mime_type; the provider would add its
  # default ("text/markdown"). Ignore just that field so import is zero-diff.
  lifecycle {
    ignore_changes = [documentation[0].mime_type]
  }
}

import {
  to = google_monitoring_alert_policy.smc_dev_api_count_alert
  id = "simplifymycloud-dev projects/simplifymycloud-dev/alertPolicies/4180276078121115290"
}

resource "google_monitoring_alert_policy" "uptime_check_policy" {
  combiner              = "OR"
  display_name          = "Uptime Check Policy"
  enabled               = true
  notification_channels = ["projects/simplifymycloud-dev/notificationChannels/5147714731520457354"]
  project               = "simplifymycloud-dev"
  user_labels           = {}
  conditions {
    display_name = "HTTP check on instance nginxstack-1-vm"
    condition_threshold {
      comparison      = "COMPARISON_GT"
      duration        = "300s"
      filter          = "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND metric.label.check_id=\"nginx-uptime-check-7orc\" AND resource.type=one_of(\"gce_instance\", \"aws_ec2_instance\")"
      threshold_value = 1
      aggregations {
        alignment_period     = "1200s"
        cross_series_reducer = "REDUCE_COUNT_FALSE"
        group_by_fields      = ["resource.label.*"]
        per_series_aligner   = "ALIGN_NEXT_OLDER"
      }
      trigger {
        count   = 1
        percent = 0
      }
    }
  }
}

