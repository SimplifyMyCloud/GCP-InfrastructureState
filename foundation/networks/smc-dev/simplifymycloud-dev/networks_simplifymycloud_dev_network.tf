#
# Imported from the live Org on 2026-11-01. Every value is what GCP reported;
# the code was generated by `terraform plan -generate-config-out` and tidied.

resource "google_compute_subnetwork" "gitlab_lb_test_01_sub" {
  ip_cidr_range              = "10.0.0.0/24"
  name                       = "gitlab-lb-test-01-sub"
  network                    = "https://www.googleapis.com/compute/v1/projects/simplifymycloud-dev/global/networks/default"
  private_ip_google_access   = false
  private_ipv6_google_access = "DISABLE_GOOGLE_ACCESS"
  project                    = "simplifymycloud-dev"
  purpose                    = "REGIONAL_MANAGED_PROXY"
  region                     = "us-west1"
  role                       = "ACTIVE"
}

import {
  to = google_compute_subnetwork.gitlab_lb_test_01_sub
  id = "projects/simplifymycloud-dev/regions/us-west1/subnetworks/gitlab-lb-test-01-sub"
}

resource "google_compute_network" "default" {
  auto_create_subnetworks                   = true
  bgp_always_compare_med                    = false
  bgp_best_path_selection_mode              = "LEGACY"
  delete_default_routes_on_create           = false
  enable_ula_internal_ipv6                  = false
  mtu                                       = 1460
  name                                      = "default"
  network_firewall_policy_enforcement_order = "AFTER_CLASSIC_FIREWALL"
  project                                   = "simplifymycloud-dev"
  routing_mode                              = "REGIONAL"
}

import {
  to = google_compute_network.default
  id = "projects/simplifymycloud-dev/global/networks/default"
}
