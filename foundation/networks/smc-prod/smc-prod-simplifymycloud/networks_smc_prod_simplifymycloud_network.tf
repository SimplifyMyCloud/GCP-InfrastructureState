# ---------------------------------------------------------------------------------------------------------------------
# Foundation Layer
# networks — smc-prod / smc-prod-simplifymycloud — VPC networks
# ---------------------------------------------------------------------------------------------------------------------
#
# Imported from the live Org on 2026-11-01. Every value is what GCP reported;
# the code was generated by `terraform plan -generate-config-out` and tidied.

resource "google_compute_network" "default" {
  auto_create_subnetworks                   = true
  bgp_always_compare_med                    = false
  bgp_best_path_selection_mode              = "LEGACY"
  delete_default_routes_on_create           = false
  description                               = "Default network for the project"
  enable_ula_internal_ipv6                  = false
  mtu                                       = 0
  name                                      = "default"
  network_firewall_policy_enforcement_order = "AFTER_CLASSIC_FIREWALL"
  project                                   = "smc-prod-simplifymycloud"
  routing_mode                              = "REGIONAL"
}

import {
  to = google_compute_network.default
  id = "projects/smc-prod-simplifymycloud/global/networks/default"
}
